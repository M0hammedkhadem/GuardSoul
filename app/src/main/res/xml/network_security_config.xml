<?xml version="1.0" encoding="utf-8"?>
<!-- Blocks ALL cleartext (http://) traffic app-wide and trusts only the
     system CA store — no user-added CAs, no per-domain exceptions. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
